# Copy to .env and generate a unique password with: python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_HEX_PASSWORD
PAPERNAS_BIND=127.0.0.1
PAPERNAS_PORT=8788
# Lightweight default. Set both to 1 and rebuild to install/enable Docling.
PAPERNAS_INSTALL_LAYOUT=0
PAPERNAS_V2_DOCLING=0
