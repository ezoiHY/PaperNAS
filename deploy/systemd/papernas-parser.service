[Unit]
Description=Paper NAS document parser
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/papernas
EnvironmentFile=%h/.config/papernas/server.env
ExecStart=%h/papernas/backend/.venv/bin/papernas-v2 worker --queues parse --concurrency 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
